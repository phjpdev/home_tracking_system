  "privacy_room_sensors": {
    "SZ": {
      "type": "thermal-ir-grid",
      "model": "Panasonic AMG8833 Grid-EYE (8x8 thermal)",
      "purpose": "presence + fall detection (no imaging)",
      "rationale": "client tested mmWave (Aqara FP2, Apollo R1) \u2014 both fail due to metal in walls. Thermal IR is RF-immune."
    },
    "BZ": {
      "type": "thermal-ir-grid + water-leak",
      "model": "Panasonic AMG8833 + Aqara water leak sensor",
      "purpose": "presence + fall detection + wet-floor secondary check",
      "rationale": "same metal-wall constraint; water sensor reduces fall false negatives."
    }
