+# pre-multiply by (19800/2700) ≈ 7.333 and (10200/1324) ≈ 7.704 so Maro's
+# SCALE+OFFSET produces the right floor-plan position.
+_LEGACY_W_MM = 19800.0
+_LEGACY_H_MM = 10200.0
