+    def _rescale_persons(self, payload: dict[str, Any]) -> dict[str, Any]:
+        """Convert plan-px coords to the legacy-mm scale Maro's endpoint expects."""
+        if self._sx is None or self._sy is None:
+            return payload
+        persons = payload.get("persons") or []
+        if not persons:
