[Unit]
Description=Tracking system multi-camera calibration web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tracking
Group=tracking
WorkingDirectory=/opt/tracking-system
Environment=PYTHONUNBUFFERED=1
Environment=TRACKING_CONFIG=/opt/tracking-system/tracking_engine/config.multi_camera.yaml
Environment=HOME=/var/lib/tracking-engine
Environment=XDG_CACHE_HOME=/var/lib/tracking-engine/.cache
Environment=XDG_CONFIG_HOME=/var/lib/tracking-engine/.config
ExecStart=/opt/tracking-system/.venv/bin/uvicorn tracking_engine.calibrate_web.app:app \
    --host 0.0.0.0 --port 8090
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/tracking-system /var/lib/tracking-engine

[Install]
WantedBy=multi-user.target
